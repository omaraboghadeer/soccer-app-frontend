{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "cli": {
        "packageManager": "npm",
        "analytics": false
    },
    "newProjectRoot": "projects",
    "projects": {
        "website": {
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss",
                    "skipTests": true
                },
                "@schematics/angular:class": {
                    "skipTests": true
                },
                "@schematics/angular:directive": {
                    "skipTests": true
                },
                "@schematics/angular:guard": {
                    "skipTests": true
                },
                "@schematics/angular:interceptor": {
                    "skipTests": true
                },
                "@schematics/angular:pipe": {
                    "skipTests": true
                },
                "@schematics/angular:resolver": {
                    "skipTests": true
                },
                "@schematics/angular:service": {
                    "skipTests": true
                }
            },
            "root": "projects/website",
            "sourceRoot": "projects/website/src",
            "prefix": "app",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "browser": "projects/website/src/main.ts",
                        "tsConfig": "projects/website/tsconfig.app.json",
                        "baseHref": "/str8kick/",
                        "deployUrl": "/str8kick/",
                        "inlineStyleLanguage": "scss",
                        "stylePreprocessorOptions": {
                            "includePaths": [
                                "projects/ui/src/lib"
                            ]
                        },
                        "assets": [
                            {
                                "glob": "**/*",
                                "input": "projects/website/public"
                            }
                        ],
                        "styles": [
                            "projects/website/src/styles.scss"
                        ],
                        "scripts": [
                            "node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"
                        ],
                        "server": "projects/website/src/main.server.ts",
                        "outputMode": "server",
                        "ssr": {
                            "entry": "projects/website/src/server.ts"
                        }
                    },
                    "configurations": {
                        "production": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "500kB",
                                    "maximumError": "1MB"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "4kB",
                                    "maximumError": "8kB"
                                }
                            ],
                            "outputHashing": "all",
                            "fileReplacements": [
                                {
                                    "replace": "projects/website/src/environments/environment.ts",
                                    "with": "projects/website/src/environments/environment.production.ts"
                                }
                            ]
                        },
                        "development": {
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true,
                            "fileReplacements": [
                                {
                                    "replace": "projects/website/src/environments/environment.ts",
                                    "with": "projects/website/src/environments/environment.development.ts"
                                }
                            ]
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "configurations": {
                        "production": {
                            "buildTarget": "website:build:production"
                        },
                        "development": {
                            "buildTarget": "website:build:development"
                        }
                    },
                    "defaultConfiguration": "development"
                },
                "deploy": {
                  "builder": "angular-cli-ghpages:deploy"
                }
            }
        },
        "portal": {
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss",
                    "skipTests": true
                },
                "@schematics/angular:class": {
                    "skipTests": true
                },
                "@schematics/angular:directive": {
                    "skipTests": true
                },
                "@schematics/angular:guard": {
                    "skipTests": true
                },
                "@schematics/angular:interceptor": {
                    "skipTests": true
                },
                "@schematics/angular:pipe": {
                    "skipTests": true
                },
                "@schematics/angular:resolver": {
                    "skipTests": true
                },
                "@schematics/angular:service": {
                    "skipTests": true
                }
            },
            "root": "projects/portal",
            "sourceRoot": "projects/portal/src",
            "prefix": "app",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "browser": "projects/portal/src/main.ts",
                        "tsConfig": "projects/portal/tsconfig.app.json",
                        "inlineStyleLanguage": "scss",
                        "assets": [
                            {
                                "glob": "**/*",
                                "input": "projects/portal/public"
                            }
                        ],
                        "styles": [
                            "projects/portal/src/styles.scss"
                        ],
                        "scripts": [
                            "node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"
                        ]
                    },
                    "configurations": {
                        "production": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "500kB",
                                    "maximumError": "1MB"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "4kB",
                                    "maximumError": "8kB"
                                }
                            ],
                            "outputHashing": "all",
                            "fileReplacements": [
                                {
                                    "replace": "projects/website/src/environments/environment.ts",
                                    "with": "projects/website/src/environments/environment.production.ts"
                                }
                            ]
                        },
                        "development": {
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true,
                            "fileReplacements": [
                                {
                                    "replace": "projects/portal/src/environments/environment.ts",
                                    "with": "projects/portal/src/environments/environment.development.ts"
                                }
                            ]
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "configurations": {
                        "production": {
                            "buildTarget": "portal:build:production"
                        },
                        "development": {
                            "buildTarget": "portal:build:development"
                        }
                    },
                    "defaultConfiguration": "development"
                }
            }
        },
        "ui": {
            "projectType": "library",
            "root": "projects/ui",
            "sourceRoot": "projects/ui/src",
            "prefix": "lib",
            "architect": {
                "build": {
                    "builder": "@angular/build:ng-packagr",
                    "configurations": {
                        "production": {
                            "tsConfig": "projects/ui/tsconfig.lib.prod.json"
                        },
                        "development": {
                            "tsConfig": "projects/ui/tsconfig.lib.json"
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                        "tsConfig": "projects/ui/tsconfig.spec.json"
                    }
                }
            }
        },
        "domain": {
            "projectType": "library",
            "root": "projects/domain",
            "sourceRoot": "projects/domain/src",
            "prefix": "lib",
            "architect": {
                "build": {
                    "builder": "@angular/build:ng-packagr",
                    "configurations": {
                        "production": {
                            "tsConfig": "projects/domain/tsconfig.lib.prod.json"
                        },
                        "development": {
                            "tsConfig": "projects/domain/tsconfig.lib.json"
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                        "tsConfig": "projects/domain/tsconfig.spec.json"
                    }
                }
            }
        },
        "data-access": {
            "projectType": "library",
            "root": "projects/data-access",
            "sourceRoot": "projects/data-access/src",
            "prefix": "lib",
            "architect": {
                "build": {
                    "builder": "@angular/build:ng-packagr",
                    "configurations": {
                        "production": {
                            "tsConfig": "projects/data-access/tsconfig.lib.prod.json"
                        },
                        "development": {
                            "tsConfig": "projects/data-access/tsconfig.lib.json"
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                        "tsConfig": "projects/data-access/tsconfig.spec.json"
                    }
                }
            }
        },
        "auth": {
            "projectType": "library",
            "root": "projects/auth",
            "sourceRoot": "projects/auth/src",
            "prefix": "lib",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss",
                    "skipTests": true
                },
                "@schematics/angular:service": {
                    "skipTests": true
                },
                "@schematics/angular:guard": {
                    "skipTests": true
                }
            },
            "architect": {
                "build": {
                    "builder": "@angular/build:ng-packagr",
                    "configurations": {
                        "production": {
                            "tsConfig": "projects/auth/tsconfig.lib.prod.json"
                        },
                        "development": {
                            "tsConfig": "projects/auth/tsconfig.lib.json"
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                        "tsConfig": "projects/auth/tsconfig.spec.json"
                    }
                }
            }
        }
    }
}